# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- virtual environments ---
.venv/
venv/
env/

# --- secrets / local config ---
.env
.env.*
.claude/settings.local.json

# --- editors and OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- build output ---
# the hub page is generated by: python viewer/build_viewer.py OUT.html
viewer/faceoff_viewer.html
# ...and the files it writes beside the page (images, lazily loaded B-tier data)
viewer/img/
viewer/data-b.*.json
*.html.js

# --- data ---
# Valve standings tree: looked at during data collection, not used by anything
data/raw/valve/
# Team logos and map art (trademarks of their owners). Kept so the hub can be
# rebuilt offline; uncomment if this repo is public and you'd rather not
# republish them (python viewer/fetch_assets.py downloads them again).
# data/raw/liquipedia_media/

# --- site build output (Vercel builds it: see vercel.json) ---
public/

# --- Faceoff derived data bundle (generated by viewer/build_bundle.py; CI rebuilds it) ---
viewer/data-bundle.json

# --- supervised roster flow: built each refresh, reviewed via an issue, never committed ---
# (scripts/promote_rosters.py rebuilds the candidate from the committed cache)
data/roster_events.candidate.json
data/roster_diff.md
